# herdr-mihi.auto-title — copy to "$(herdr plugin config-dir herdr-mihi.auto-title)/.env" and edit.
# All optional. Read once at startup (restart the herdr server to apply changes).

# Poll interval in milliseconds (also the max rename rate)
# POLL_MS=500

# Longest title, in terminal columns (titles are truncated to fit)
# MAX_LENGTH=50

# Log at debug level to the plugin log
# DEBUG=false
