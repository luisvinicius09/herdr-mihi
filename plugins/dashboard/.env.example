# herdr-mihi.dashboard — copy to "$(herdr plugin config-dir herdr-mihi.dashboard)/.env"
# Env vars override these; a bad value keeps the default.

# --- popup size (full-screen by default, for the screensaver look) ---
POPUP_WIDTH=100%
POPUP_HEIGHT=100%

# --- watcher (background toasts) ---
WATCHER=on                 # on | off  — the whole [[startup]] watcher
ALERT_ON=blocked,done      # which transitions raise a toast (subset of: blocked done working idle)
ALERT_SOUND=none           # none | done | request  (herdr notification.show sound)
POLL_MS=1000               # watcher poll+diff cadence

# --- theme (matches your herdr [theme] by default) ---
THEME=auto                 # auto (match herdr) | herdr-mihi | dracula | tokyonight | catppuccin |
                           #   nord | gruvbox | solarized | onedark | rose-pine | kanagawa | everforest
CANVAS_BG=auto             # auto (from theme) | #rrggbb to override the background
ACCENT=auto                # auto (from theme) | #rrggbb to override the accent

# --- popup view (the "agent screen") ---
REFRESH_MS=2000            # auto-refresh the open popup every N ms (0 = refresh only on 'r')
EFFECT=rain                # background effect: none|rain|stars|beam|snow|wave|life|fireworks ('e' cycles)
FRAME_MS=80                # animation frame interval (ms) while an effect is active
IDLE_DIM_S=60              # dim the card after N seconds without a keypress (0 = never dim)
MAX_ROWS=200               # cap rows rendered
ICONS=auto                 # auto (match herdr's ui.status_indicators) | symbols | dots | nerd | unicode | ascii
