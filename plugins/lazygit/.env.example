# herdr-mihi.lazygit — copy to "$(herdr plugin config-dir herdr-mihi.lazygit)/.env" and edit.
# All optional.

# Path to your lazygit (default: found on PATH)
# LAZYGIT_BIN=lazygit

# How lazygit opens when you invoke `open` (default: popup):
#   popup = floating overlay; covers the workspace, doesn't rearrange your split; rooted at the
#           current worktree (session-modal — one at a time, not persistent — a herdr limitation)
#   side  = a split pane beside your work (workspace-tied, persistent)
# (You can also bind the `open-side` action to always get the side pane, regardless of this.)
# PLACEMENT=popup

# Popup size — only used for the popup (e.g. 80% or a column/row count)
# POPUP_WIDTH=80%
# POPUP_HEIGHT=80%
